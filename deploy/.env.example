# Copy to deploy/.env and edit. This file contains no secrets
# (the database passwords and the master key are created by the stack on its first start).

# DNS name of the server. Browsers use https://LIBREPATCH_HOSTNAME, agents use LIBREPATCH_HOSTNAME:8443.
LIBREPATCH_HOSTNAME=librepatch.example.com

# Browser-facing TLS:
#   internal            Caddy's own CA. For LAN-only installs; distribute Caddy's root
#                       (docker compose cp caddy:/data/caddy/pki/authorities/local/root.crt .)
#                       to admin workstations, e.g. via GPO.
#   you@example.com     Public certificate from Let's Encrypt (ports 80/443 must be reachable).
LIBREPATCH_CADDY_TLS=internal

# Optional: a different name agents should dial, and extra gateway certificate SANs
# (comma-separated DNS names or IPs), e.g. an IP for agents that cannot resolve DNS.
#LIBREPATCH_GATEWAY_HOSTNAME=agents.example.com
#LIBREPATCH_GATEWAY_SANS=10.0.0.10

# Ports (defaults shown).
#LIBREPATCH_HTTP_PORT=80
#LIBREPATCH_HTTPS_PORT=443
#LIBREPATCH_GATEWAY_PORT=8443
# If LIBREPATCH_HTTPS_PORT is not 443, set this to ":<port>" so the console origin matches.
#LIBREPATCH_PUBLIC_PORT_SUFFIX=

# Behind your own reverse proxy (for example the Synology DSM reverse proxy) doing the browser TLS: use the plain-HTTP
# Caddyfile, keep Caddy off the network (loopback only), and tell it which addresses to believe X-Forwarded-For from.
# See docs/RUNBOOK.md, "Behind your own reverse proxy". Space-separated CIDRs or addresses.
#LIBREPATCH_CADDYFILE=./Caddyfile.behind-proxy
#LIBREPATCH_HTTP_PORT=127.0.0.1:8080
#LIBREPATCH_HTTPS_PORT=8444
#LIBREPATCH_UPSTREAM_PROXIES=172.31.250.0/24

# Docker network between Caddy and the server, and Caddy's fixed address in it
# (X-Forwarded-For is trusted only from LIBREPATCH_CADDY_IP). Keep them consistent.
#LIBREPATCH_FRONTEND_SUBNET=172.31.250.0/24
#LIBREPATCH_CADDY_IP=172.31.250.10

# Software catalog (Phase 3). Importing from the winget-pkgs repository needs the server to reach
# raw.githubusercontent.com and api.github.com; set "off" to disable it (custom uploads still work).
#LIBREPATCH_WINGET_SOURCE=github
# "off" also stops the daily download of the winget index (3.7 MB from cdn.winget.microsoft.com). An internal mirror of the
# index can be named here (https only).
#LIBREPATCH_WINGET_INDEX_URL=

# Extra vendor release public keys (hex, comma-separated) accepted for agent release uploads.
# Only for testing your own release builds; agents trust just the keys compiled into them.
#LIBREPATCH_RELEASE_PUBLIC_KEYS=


# Only for deploy/docker-compose.image.yml (the published server image, see docs/RUNBOOK.md "Install from the published image").
# LIBREPATCH_VERSION pins the release to run, for example 1.0.0. Unset means "latest". "edge" is the newest build of main.
#LIBREPATCH_VERSION=latest
# Another registry or fork:
#LIBREPATCH_IMAGE=ghcr.io/auzring1/librepatch-server
