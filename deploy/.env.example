# Copy to deploy/.env and edit. This file contains no secrets
# (those live in deploy/secrets/, created by scripts/init-secrets.sh).

# DNS name of the server. Browsers use https://AUZ_HOSTNAME, agents use AUZ_HOSTNAME:8443.
AUZ_HOSTNAME=renovatio.example.com

# Browser-facing TLS:
#   internal            Caddy's own CA. For LAN-only installs; distribute Caddy's root
#                       (docker compose cp caddy:/data/caddy/pki/authorities/local/root.crt .)
#                       to admin workstations, e.g. via GPO.
#   you@example.com     Public certificate from Let's Encrypt (ports 80/443 must be reachable).
AUZ_CADDY_TLS=internal

# Optional: a different name agents should dial, and extra gateway certificate SANs
# (comma-separated DNS names or IPs), e.g. an IP for agents that cannot resolve DNS.
#AUZ_GATEWAY_HOSTNAME=agents.example.com
#AUZ_GATEWAY_SANS=10.0.0.10

# Ports (defaults shown).
#AUZ_HTTP_PORT=80
#AUZ_HTTPS_PORT=443
#AUZ_GATEWAY_PORT=8443
# If AUZ_HTTPS_PORT is not 443, set this to ":<port>" so the console origin matches.
#AUZ_PUBLIC_PORT_SUFFIX=

# Docker network between Caddy and the server, and Caddy's fixed address in it
# (X-Forwarded-For is trusted only from AUZ_CADDY_IP). Keep them consistent.
#AUZ_FRONTEND_SUBNET=172.31.250.0/24
#AUZ_CADDY_IP=172.31.250.10

# Software catalog (Phase 3). Importing from the winget-pkgs repository needs the server to reach
# raw.githubusercontent.com and api.github.com; set "off" to disable it (custom uploads still work).
#AUZ_WINGET_SOURCE=github

# Extra vendor release public keys (hex, comma-separated) accepted for agent release uploads.
# Only for testing your own release builds; agents trust just the keys compiled into them.
#AUZ_RELEASE_PUBLIC_KEYS=

# Extra vendor LICENSE public keys (hex, comma-separated), for testing licensing with a demo key made by
# `renovatio-license keygen`. Official builds carry the vendor key inside them. Never use a demo key in production.
#AUZ_LICENSE_PUBLIC_KEYS=
