# syntax=docker/dockerfile:1.7
# Auzring server image: web console + API + agent gateway in one static binary
# on a distroless, non-root base. Base images are pinned by digest
# (update them deliberately, e.g. via Renovate).

FROM node:22-alpine@sha256:0a7108bf6c7bf5de370ffb1a3ed6be93d405b43ff159f681a8d18c0e2bc2e402 AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
# Optional build secret "extra_ca": a corporate TLS-inspection root, only if your
# build network needs it. It is never copied into an image layer.
RUN --mount=type=secret,id=extra_ca,required=false \
    if [ -s /run/secrets/extra_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/extra_ca; fi; \
    npm ci --no-audit --no-fund --ignore-scripts
COPY api/ /src/api/
COPY web/ ./
RUN mkdir -p /src/internal/server/webui/dist && npm run build

FROM golang:1.27-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS build
WORKDIR /src
ENV CGO_ENABLED=0 GOFLAGS=-mod=readonly GOTOOLCHAIN=local
COPY go.mod go.sum ./
RUN --mount=type=secret,id=extra_ca,required=false \
    if [ -s /run/secrets/extra_ca ]; then export SSL_CERT_FILE=/run/secrets/extra_ca; fi; \
    go mod download
COPY . .
COPY --from=web /src/internal/server/webui/dist ./internal/server/webui/dist
ARG VERSION=0.1.0-dev
ARG COMMIT=unknown
# Vendor license public key(s), hex, comma-separated (a public value). Empty = "licensing not configured":
# the server then runs unlicensed (evaluation limits).
ARG LICENSE_PUBLIC_KEYS=
RUN go build -trimpath \
      -ldflags "-s -w -X github.com/auzring1/auzring/internal/shared/version.Version=${VERSION} -X github.com/auzring1/auzring/internal/shared/version.Commit=${COMMIT} -X github.com/auzring1/auzring/internal/shared/license.PublicKeysHex=${LICENSE_PUBLIC_KEYS}" \
      -o /out/auzring-server ./cmd/auzring-server

# Empty content directory owned by the runtime user; compose mounts a volume over it.
RUN mkdir -p /out/content && chown 65532:65532 /out/content && chmod 700 /out/content

FROM gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab
COPY --from=build /out/auzring-server /auzring-server
COPY --from=build --chown=65532:65532 /out/content /var/lib/auzring/content
USER 65532:65532
EXPOSE 8080 8443
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 CMD ["/auzring-server", "healthcheck"]
ENTRYPOINT ["/auzring-server"]
CMD ["serve"]
